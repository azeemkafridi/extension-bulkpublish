{
  "name": "extension-bulkpublish",
  "version": "0.2.0",
  "description": "Browser extension for BulkPublish — compose, schedule, and publish to 15 social media platforms from any page.",
  "type": "module",
  "private": true,
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "social-media",
    "publishing",
    "scheduling",
    "bulkpublish"
  ],
  "license": "MIT",
  "homepage": "https://github.com/azeemkafridi/extension-bulkpublish",
  "author": {
    "name": "BulkPublish",
    "email": "chrome@bulkpublish.com",
    "url": "https://bulkpublish.com"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test": "node --test 'tests/*.test.js'",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@wxt-dev/module-react": "^1.1.3",
    "wxt": "^0.20.6"
  }
}
